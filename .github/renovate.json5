// Renovate configuration. The shared base (managers, grouping, release-age cooldown,
// badges) lives in https://github.com/AmineDjeghri/renovate-config (default.json5).
// Rules below are repo-specific and override the shared ones (later rules win).
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>AmineDjeghri/renovate-config:default.json5"],

  packageRules: [
    // ---- Repo-specific rules (keep last) ----
    // pyproject.toml: runtime dependencies, extras (overrides the shared pin)
    {
      description: "Widen library runtime and optional dependency ranges while preserving compatible older versions",
      matchManagers: ["pep621"],
      matchDepTypes: ["dependencies", "project.dependencies", "project.optional-dependencies"],
      rangeStrategy: "widen",
    },
  ],
}
